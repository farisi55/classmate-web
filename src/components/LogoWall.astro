---
import { Image } from 'astro:assets';
import type { LogoEntry } from '../lib/types';

interface Props {
  entries: LogoEntry[];
  /** Klien & Venue page uses the cleaner, more formal tone per
   * knowledge.md §6 tone-modulation rule — slightly more grid discipline. */
  clean?: boolean;
}
const { entries, clean = false } = Astro.props;
---

<div class:list={['grid grid-cols-2 gap-4 sm:grid-cols-3', clean ? 'md:grid-cols-5' : 'md:grid-cols-4']}>
  {entries.map((entry) =>
    entry.logoSrc ? (
      <div class="flex items-center justify-center rounded-sm border border-border bg-white p-4 h-20">
        <Image src={entry.logoSrc} alt={entry.name} class="max-h-10 w-auto object-contain" loading="lazy" />
      </div>
    ) : (
      <div class="flex items-center justify-center rounded-sm border border-border bg-white p-4 h-20 text-center">
        <span class="font-body font-semibold text-sm text-ink-soft leading-tight">{entry.name}</span>
      </div>
    )
  )}
</div>
