---
import type { Locale } from '../../lib/types';
import { clientLogos, venueLogos } from '../../data/testimonials-clients';
import { uiStrings, t } from '../../data/ui-strings';
import { buildWhatsAppLink } from '../../data/site-config';
import LogoWall from '../LogoWall.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section class="container-content pt-12 pb-10 sm:pt-16">
  <p class="eyebrow mb-3">{lang === 'id' ? 'Kolaborasi' : 'Collaborations'}</p>
  <h1 class="font-display text-h1 mb-4 max-w-2xl">
    {lang === 'id' ? 'Klien & Venue Partner Kami' : 'Our Clients & Venue Partners'}
  </h1>
  <p class="text-ink-soft max-w-xl">
    {lang === 'id'
      ? 'Dari developer properti, sekolah, hingga brand nasional — berikut sebagian pihak yang sudah bekerja sama dengan Classmate.'
      : 'From property developers and schools to national brands — a selection of the organizations that have worked with Classmate.'}
  </p>
</section>

<section class="container-content pb-16">
  <h2 class="font-display text-h3 mb-6">{lang === 'id' ? 'Klien Korporat' : 'Corporate Clients'}</h2>
  <LogoWall entries={clientLogos} clean />
</section>

<section class="bg-white py-16">
  <div class="container-content">
    <h2 class="font-display text-h3 mb-6">{lang === 'id' ? 'Venue Partner' : 'Venue Partners'}</h2>
    <LogoWall entries={venueLogos} clean />
  </div>
</section>

<section class="container-content py-16 text-center">
  <h2 class="font-display text-h2 mb-3">{lang === 'id' ? 'Ingin berkolaborasi?' : 'Interested in collaborating?'}</h2>
  <p class="text-ink-soft mb-6 max-w-md mx-auto">
    {lang === 'id' ? 'Ceritakan kebutuhan acara atau venue kamu, tim kami akan bantu susun konsepnya.' : 'Tell us about your event or venue needs — our team will help shape the concept.'}
  </p>
  <a href={buildWhatsAppLink('')} target="_blank" rel="noopener" class="btn-primary">
    {t(uiStrings.cta.whatsapp, lang)}
  </a>
</section>
