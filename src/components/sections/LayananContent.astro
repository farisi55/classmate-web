---
import type { Locale } from '../../lib/types';
import { packages } from '../../data/packages';
import PackageCard from '../PackageCard.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
---

<section class="container-content pt-12 pb-6 sm:pt-16">
  <p class="eyebrow mb-3">{lang === 'id' ? 'Harga & Paket' : 'Pricing & Packages'}</p>
  <h1 class="font-display text-h1 mb-4 max-w-2xl">
    {lang === 'id' ? 'Paket Art Party 2026, untuk Semua Usia' : '2026 Art Party Packages, for All Ages'}
  </h1>
  <p class="text-ink-soft max-w-xl">
    {lang === 'id'
      ? 'Empat pilihan sesuai jumlah peserta dan kebutuhan acaramu — dari sekadar mengisi aktivitas sampai perayaan seharian penuh.'
      : 'Four options based on your headcount and event needs — from a simple activity filler to a full day celebration.'}
  </p>
</section>

<section class="container-content pb-16 sm:pb-20">
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {packages.map((pkg) => <PackageCard lang={lang} pkg={pkg} />)}
  </div>
</section>

<section class="bg-white py-16">
  <div class="container-content max-w-2xl">
    <h2 class="font-display text-h2 mb-4">{lang === 'id' ? 'Catatan Umum' : 'General Notes'}</h2>
    <ul class="space-y-2 text-sm text-ink-soft">
      <li>• {lang === 'id' ? 'Gratis: singing & dancing, story telling, dan fun games untuk anak-anak.' : 'Free: singing & dancing, storytelling, and fun games for kids.'}</li>
      <li>• {lang === 'id' ? 'Termasuk merchandise dan apron (dipinjamkan) di setiap paket.' : 'Merchandise and an apron (on loan) are included in every package.'}</li>
      <li>• {lang === 'id' ? '"Kelas Lainnya" (28 pilihan tambahan seperti resin, macrame, baking) dipesan terpisah dari paket ini, minimum 20 peserta — lihat halaman Aktivitas.' : '"Other Classes" (28 add-on options like resin, macrame, baking) are booked separately from these packages, minimum 20 participants — see the Activities page.'}</li>
    </ul>
  </div>
</section>
