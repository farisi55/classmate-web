{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Override Astro's base JSX settings (`jsx: "preserve"`, `jsxImportSource: "astro"`):
    // .tsx islands in src/components/islands/ are React 18 components rendered by @astrojs/react.
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    // Path alias. No `baseUrl` needed since TS 4.1 - `paths` entries are resolved
    // relative to this file, so keep the leading "./". This avoids enabling fragile
    // root-relative (non-relative) imports like `import x from "src/lib/types"`.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `.astro/types.d.ts` is generated by `astro dev`/`astro build` and backs the
  // ambient types for `*.astro` imports and `astro:assets` (see src/env.d.ts).
  "include": [".astro/types.d.ts", "**/*"],
  // `functions/` (Cloudflare Pages Functions) is type-checked by its own config
  // (functions/tsconfig.json) against @cloudflare/workers-types, so it is kept
  // out of the Astro-side check; `dist/` is only excluded to keep the build output
  // out of `**/*` even though `noEmit` ignores it.
  "exclude": ["dist", "node_modules", "functions"]
}
